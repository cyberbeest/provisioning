+#define SHUTDOWN_CONFIRM_TIMEOUT_SECONDS 4
+
+static gboolean
+shutdown_disarm_timeout (gpointer data) {
+    GSLockPlug *plug = GS_LOCK_PLUG (data);
+
+    if (plug->priv->auth_shutdown_button != NULL) {
+        gtk_button_set_label (GTK_BUTTON (plug->priv->auth_shutdown_button), "Shut _Down");
+        gtk_style_context_remove_class (
+            gtk_widget_get_style_context (plug->priv->auth_shutdown_button),
+            "destructive-action");
+    }
+
+    plug->priv->shutdown_armed = FALSE;
+    plug->priv->shutdown_disarm_timeout_id = 0;
+
+    return G_SOURCE_REMOVE;
+}
+
+static void
+shutdown_button_clicked (GtkButton  *button,
+                         GSLockPlug *plug) {
+    if (!plug->priv->shutdown_armed) {
+        plug->priv->shutdown_armed = TRUE;
+        gtk_button_set_label (GTK_BUTTON (button), "Really Shut Down?");
+        gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (button)),
+                                     "destructive-action");
+
+        if (plug->priv->shutdown_disarm_timeout_id > 0) {
+            g_source_remove (plug->priv->shutdown_disarm_timeout_id);
+        }
+        plug->priv->shutdown_disarm_timeout_id =
+            g_timeout_add_seconds (SHUTDOWN_CONFIRM_TIMEOUT_SECONDS,
+                                   shutdown_disarm_timeout, plug);
+        return;
+    }
+
+    if (plug->priv->shutdown_disarm_timeout_id > 0) {
+        g_source_remove (plug->priv->shutdown_disarm_timeout_id);
+        plug->priv->shutdown_disarm_timeout_id = 0;
+    }
+    plug->priv->shutdown_armed = FALSE;
+
+    gtk_button_set_label (GTK_BUTTON (button), "Shutting Down…");
+    gtk_widget_set_sensitive (GTK_WIDGET (button), FALSE);
+
+    {
+        GError *error = NULL;
+
+        g_spawn_command_line_async ("systemctl poweroff", &error);
+        if (error) {
+            g_warning ("Could not run shutdown command: %s", error->message);
+            g_error_free (error);
+        }
+    }
+}
