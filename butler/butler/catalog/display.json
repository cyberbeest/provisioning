    {
      "id": "fullscreen",
      "title": {
        "en": "Fullscreen",
        "de": "Vollbild"
      },
      "sentence": {
        "en": "Toggle fullscreen for the active window",
        "de": "Vollbild für das aktive Fenster umschalten"
      },
      "examples": {
        "en": [
          "make it fullscreen",
          "go fullscreen",
          "make this window big",
          "full screen please"
        ],
        "de": [
          "Vollbild",
          "mach das Fenster im Vollbild",
          "Fenster ganz groß machen",
          "Vollbildmodus bitte"
        ]
      },
      "reply": {
        "en": "Fullscreen.",
        "de": "Vollbild."
      },
      "run": {
        "argv": [
          "wmctrl",
          "-r",
          ":ACTIVE:",
          "-b",
          "toggle,fullscreen"
