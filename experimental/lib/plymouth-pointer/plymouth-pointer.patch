diff -ruN a/src/libply-splash-core/ply-pointer.c b/src/libply-splash-core/ply-pointer.c
--- a/src/libply-splash-core/ply-pointer.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/libply-splash-core/ply-pointer.c	2026-09-29 15:14:09.174383373 +0200
@@ -0,0 +1,242 @@
+/* ply-pointer.c - mouse pointer position and image
+ *
+ * Copyright (C) 2026
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2, or (at your option)
+ * any later version.
+ */
+#include "config.h"
+#include "ply-pointer.h"
+
+#include <stdlib.h>
+
+/* Premultiplied ARGB of the arrow's fill. Override at build time (with
+ * -Dc_args=-DPLY_POINTER_FILL_COLOR=0xffff0000) to tell it apart when testing.
+ */
+#ifndef PLY_POINTER_FILL_COLOR
+#define PLY_POINTER_FILL_COLOR 0xffffffff
+#endif
+
+/* Build with -DPLY_POINTER_MIRRORED=1 to flip the arrow (the hotspot moves to
+ * its top right), which tells it apart from the host pointer in a VM window.
+ */
+#ifndef PLY_POINTER_MIRRORED
+#define PLY_POINTER_MIRRORED 0
+#endif
+
+/* Classic arrow, hotspot at the top left. X is outline, . is fill. */
+static const char *arrow[] = {
+        "X           ",
+        "XX          ",
+        "X.X         ",
+        "X..X        ",
+        "X...X       ",
+        "X....X      ",
+        "X.....X     ",
+        "X......X    ",
+        "X.......X   ",
+        "X........X  ",
+        "X.....XXXXX ",
+        "X..X..X     ",
+        "X.X X..X    ",
+        "XX  X..X    ",
+        "X    X..X   ",
+        "     X..X   ",
+        "      X..X  ",
+        "      X..X  ",
+        "       XX   ",
+};
+
+#define ARROW_WIDTH  12
+#define ARROW_HEIGHT ((int) (sizeof(arrow) / sizeof(arrow[0])))
+
+/* Panels at least this tall get an arrow twice the size */
+#define LARGE_PANEL_HEIGHT 1600
+
+struct _ply_pointer
+{
+        double x;
+        double y;
+        int    scale;
+        bool   visible;
+};
+
+ply_pointer_t *
+ply_pointer_new (void)
+{
+        ply_pointer_t *pointer = calloc (1, sizeof(ply_pointer_t));
+
+        pointer->scale = 1;
+        return pointer;
+}
+
+void
+ply_pointer_free (ply_pointer_t *pointer)
+{
+        free (pointer);
+}
+
+void
+ply_pointer_handle_motion (ply_pointer_t             *pointer,
+                           const ply_pointer_event_t *event,
+                           const ply_rectangle_t     *bounds)
+{
+        double left = bounds->x, top = bounds->y;
+        double right = bounds->x + (double) bounds->width - 1;
+        double bottom = bounds->y + (double) bounds->height - 1;
+
+        if (!pointer->visible) {
+                pointer->x = bounds->x + bounds->width / 2.0;
+                pointer->y = bounds->y + bounds->height / 2.0;
+                pointer->scale = bounds->height >= LARGE_PANEL_HEIGHT ? 2 : 1;
+                pointer->visible = true;
+        }
+
+        if (event->absolute) {
+                pointer->x = left + event->x * (bounds->width - 1);
+                pointer->y = top + event->y * (bounds->height - 1);
+        } else {
+                pointer->x += event->x;
+                pointer->y += event->y;
+        }
+
+        if (pointer->x < left)
+                pointer->x = left;
+        if (pointer->y < top)
+                pointer->y = top;
+        if (pointer->x > right)
+                pointer->x = right;
+        if (pointer->y > bottom)
+                pointer->y = bottom;
+}
+
+bool
+ply_pointer_is_visible (ply_pointer_t *pointer)
+{
+        return pointer->visible;
+}
+
+double
+ply_pointer_get_x (ply_pointer_t *pointer)
+{
+        return pointer->x;
+}
+
+double
+ply_pointer_get_y (ply_pointer_t *pointer)
+{
+        return pointer->y;
+}
+
+int
+ply_pointer_get_width (ply_pointer_t *pointer)
+{
+        return ARROW_WIDTH * pointer->scale;
+}
+
+int
+ply_pointer_get_height (ply_pointer_t *pointer)
+{
+        return ARROW_HEIGHT * pointer->scale;
+}
+
+int
+ply_pointer_get_hotspot_x (ply_pointer_t *pointer)
+{
+        return PLY_POINTER_MIRRORED ? ply_pointer_get_width (pointer) - 1 : 0;
+}
+
+uint32_t
+ply_pointer_get_pixel (ply_pointer_t *pointer,
+                       int            x,
+                       int            y)
+{
+        int column = PLY_POINTER_MIRRORED ? ply_pointer_get_width (pointer) - 1 - x : x;
+        char pixel;
+
+        if (x < 0 || y < 0 || x >= ply_pointer_get_width (pointer) || y >= ply_pointer_get_height (pointer))
+                return 0;
+
+        pixel = arrow[y / pointer->scale][column / pointer->scale];
+
+        if (pixel == 'X')
+                return 0xff000000;
+        if (pixel == '.')
+                return PLY_POINTER_FILL_COLOR;
+        return 0;
+}
+
+void
+ply_pointer_limit_size (ply_pointer_t *pointer,
+                        int            max_width,
+                        int            max_height)
+{
+        while (pointer->scale > 1 &&
+               (ply_pointer_get_width (pointer) > max_width ||
+                ply_pointer_get_height (pointer) > max_height))
+                pointer->scale--;
+}
+
+bool
+ply_pointer_is_on_head (ply_pointer_t         *pointer,
+                        const ply_rectangle_t *head_area)
+{
+        return pointer->x >= head_area->x &&
+               pointer->x < head_area->x + (double) head_area->width &&
+               pointer->y >= head_area->y &&
+               pointer->y < head_area->y + (double) head_area->height;
+}
+
+bool
+ply_pointer_get_area_on_head (ply_pointer_t         *pointer,
+                              const ply_rectangle_t *head_area,
+                              long                  *left,
+                              long                  *top,
+                              ply_rectangle_t       *visible)
+{
+        long right, bottom;
+
+        if (!ply_pointer_is_on_head (pointer, head_area))
+                return false;
+
+        *left = (long) (pointer->x - head_area->x) - ply_pointer_get_hotspot_x (pointer);
+        *top = (long) (pointer->y - head_area->y);
+
+        right = *left + ply_pointer_get_width (pointer);
+        bottom = *top + ply_pointer_get_height (pointer);
+
+        visible->x = *left < 0 ? 0 : *left;
+        visible->y = *top < 0 ? 0 : *top;
+        visible->width = (right > (long) head_area->width ? (long) head_area->width : right) - visible->x;
+        visible->height = (bottom > (long) head_area->height ? (long) head_area->height : bottom) - visible->y;
+
+        return true;
+}
+
+bool
+ply_pointer_draw_xrgb32 (ply_pointer_t         *pointer,
+                         const ply_rectangle_t *head_area,
+                         char                  *map_address,
+                         unsigned long          row_stride,
+                         ply_rectangle_t       *drawn)
+{
+        long left, top, x, y;
+
+        if (!ply_pointer_get_area_on_head (pointer, head_area, &left, &top, drawn))
+                return false;
+
+        for (y = drawn->y; y < (long) (drawn->y + drawn->height); y++) {
+                uint32_t *dst = (uint32_t *) (map_address + y * row_stride);
+
+                for (x = drawn->x; x < (long) (drawn->x + drawn->width); x++) {
+                        uint32_t pixel = ply_pointer_get_pixel (pointer, x - left, y - top);
+
+                        if (pixel >> 24)
+                                dst[x] = pixel & 0x00ffffff;
+                }
+        }
+
+        return true;
+}
