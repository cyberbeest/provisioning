+static void
+draw_software_cursor (ply_renderer_backend_t *backend,
+                      ply_renderer_head_t    *head,
+                      char                   *map_address)
+{
+        ply_rectangle_t area;
+
+        if (head->sw_cursor_drawn) {
+                ply_renderer_head_flush_area (head, &head->sw_cursor_area, map_address);
+                head->sw_cursor_drawn = false;
+        }
+
+        if (ply_pointer_draw_xrgb32 (backend->pointer, &head->area, map_address,
+                                     head->row_stride, &area)) {
+                head->sw_cursor_area = area;
+                head->sw_cursor_drawn = true;
+        }
+}
+
+static void
+update_software_cursor (ply_renderer_backend_t *backend)
+{
+        ply_list_node_t *node;
+
+        ply_list_foreach (backend->heads, node) {
+                ply_renderer_head_t *head = ply_list_node_get_data (node);
+                char *map_address;
+
+                if (!head->scan_out_buffer_id)
+                        continue;
+
+                map_address = begin_flush (backend, head->scan_out_buffer_id);
+                draw_software_cursor (backend, head, map_address);
+                end_flush (backend, head->scan_out_buffer_id);
+        }
+}
+
+static bool
+create_cursor_buffer (ply_renderer_backend_t *backend)
+{
+        struct drm_mode_create_dumb create = { 0 };
+        struct drm_mode_map_dumb map = { 0 };
+        uint64_t width = 64, height = 64;
+        uint8_t *pixels;
+        int x, y;
+
+        drmGetCap (backend->device_fd, DRM_CAP_CURSOR_WIDTH, &width);
+        drmGetCap (backend->device_fd, DRM_CAP_CURSOR_HEIGHT, &height);
+
+        ply_pointer_limit_size (backend->pointer, width, height);
+
+        create.width = width;
+        create.height = height;
+        create.bpp = 32;
+
+        if (drmIoctl (backend->device_fd, DRM_IOCTL_MODE_CREATE_DUMB, &create) < 0) {
+                ply_trace ("Couldn't create cursor buffer: %m");
+                return false;
+        }
+
+        map.handle = create.handle;
+        if (drmIoctl (backend->device_fd, DRM_IOCTL_MODE_MAP_DUMB, &map) < 0)
+                goto fail;
+
+        pixels = mmap (NULL, create.size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                       backend->device_fd, map.offset);
+        if (pixels == MAP_FAILED)
+                goto fail;
+
+        memset (pixels, 0, create.size);
+        for (y = 0; y < ply_pointer_get_height (backend->pointer); y++) {
+                uint32_t *out = (uint32_t *) (pixels + y * create.pitch);
+
+                for (x = 0; x < ply_pointer_get_width (backend->pointer); x++)
+                        out[x] = ply_pointer_get_pixel (backend->pointer, x, y);
+        }
+        munmap (pixels, create.size);
+
+        ply_trace ("Created %dx%d hardware cursor buffer",
+                   (int) width, (int) height);
+        backend->cursor_handle = create.handle;
+        backend->cursor_width = width;
+        backend->cursor_height = height;
+        return true;
+
+fail:
+        ply_trace ("Couldn't map cursor buffer: %m");
+        {
+                struct drm_mode_destroy_dumb destroy = { .handle = create.handle };
+                drmIoctl (backend->device_fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy);
+        }
+        return false;
+}
+
+static void
+update_cursor (ply_renderer_backend_t *backend)
+{
+        ply_list_node_t *node;
+        int hotspot_x;
+
+        if (!ply_pointer_is_visible (backend->pointer) || !backend->is_active)
+                return;
+
+        if (backend->cursor_software) {
+                update_software_cursor (backend);
+                return;
+        }
+
+        if (backend->cursor_handle == 0 && !create_cursor_buffer (backend)) {
+                ply_trace ("Hardware cursor not available, drawing the mouse pointer in software");
+                backend->cursor_software = true;
+                update_software_cursor (backend);
+                return;
+        }
+
+        hotspot_x = ply_pointer_get_hotspot_x (backend->pointer);
+
+        ply_list_foreach (backend->heads, node) {
+                ply_renderer_head_t *head = ply_list_node_get_data (node);
+
+                if (ply_pointer_is_on_head (backend->pointer, &head->area)) {
+                        if (!head->cursor_shown) {
+                                if (drmModeSetCursor2 (backend->device_fd, head->controller_id,
+                                                       backend->cursor_handle,
+                                                       backend->cursor_width,
+                                                       backend->cursor_height,
+                                                       hotspot_x, 0) < 0) {
+                                        ply_trace ("Couldn't set cursor on controller %d: %m, drawing the mouse pointer in software",
+                                                   head->controller_id);
+                                        backend->cursor_software = true;
+                                        update_software_cursor (backend);
+                                        return;
+                                }
+                                head->cursor_shown = true;
+                                ply_trace ("Showing mouse pointer on controller %d",
+                                           head->controller_id);
+                        }
+                        drmModeMoveCursor (backend->device_fd, head->controller_id,
+                                           (int) (ply_pointer_get_x (backend->pointer) - head->area.x) - hotspot_x,
+                                           (int) (ply_pointer_get_y (backend->pointer) - head->area.y));
+                } else if (head->cursor_shown) {
+                        drmModeSetCursor (backend->device_fd, head->controller_id, 0, 0, 0);
+                        head->cursor_shown = false;
+                }
+        }
+}
+
+static bool
+get_pointer_bounds (ply_renderer_backend_t *backend,
+                    ply_rectangle_t        *bounds)
+{
+        ply_list_node_t *node;
+        long x2 = 0, y2 = 0;
+        bool first = true;
+
+        ply_list_foreach (backend->heads, node) {
+                ply_renderer_head_t *head = ply_list_node_get_data (node);
+
+                if (first || head->area.x < bounds->x)
+                        bounds->x = head->area.x;
+                if (first || head->area.y < bounds->y)
+                        bounds->y = head->area.y;
+                if (first || head->area.x + (long) head->area.width > x2)
+                        x2 = head->area.x + head->area.width;
+                if (first || head->area.y + (long) head->area.height > y2)
+                        y2 = head->area.y + head->area.height;
+                first = false;
+        }
+
+        if (first)
+                return false;
+
+        bounds->width = x2 - bounds->x;
+        bounds->height = y2 - bounds->y;
+        return true;
+}
+
+/* Tell the splash where the pointer is, relative to the head it is on */
+static void
+notify_pointer (ply_renderer_backend_t         *backend,
+                ply_renderer_pointer_action_t   action,
+                int                             button)
+{
+        ply_list_node_t *node;
+
+        if (backend->pointer_handler == NULL || !ply_pointer_is_visible (backend->pointer))
+                return;
+
+        ply_list_foreach (backend->heads, node) {
+                ply_renderer_head_t *head = ply_list_node_get_data (node);
+
+                if (ply_pointer_is_on_head (backend->pointer, &head->area)) {
+                        backend->pointer_handler (backend->pointer_handler_user_data,
+                                                  action, head,
+                                                  (int) (ply_pointer_get_x (backend->pointer) - head->area.x),
+                                                  (int) (ply_pointer_get_y (backend->pointer) - head->area.y),
+                                                  button);
+                        return;
+                }
+        }
+}
+
+static int
+pointer_button_number (int code)
+{
+        switch (code) {
+        case BTN_LEFT:
+        case BTN_TOUCH:
+                return 1;
+        case BTN_RIGHT:
+                return 2;
+        case BTN_MIDDLE:
+                return 3;
+        }
+        return 0;
+}
+
+static void
+on_pointer_event (ply_renderer_backend_t *backend,
+                  ply_input_device_t     *input_device,
+                  const ply_pointer_event_t *event)
+{
+        ply_rectangle_t bounds = { 0 };
+
+        if (event->type == PLY_POINTER_EVENT_BUTTON) {
+                int button = pointer_button_number (event->button);
+
+                if (button != 0)
+                        notify_pointer (backend,
+                                        event->pressed ? PLY_RENDERER_POINTER_PRESSED : PLY_RENDERER_POINTER_RELEASED,
+                                        button);
+                return;
+        }
+
+        if (!get_pointer_bounds (backend, &bounds)) {
+                ply_trace ("Pointer motion, but there are no heads to move on");
+                return;
+        }
+
+        if (!ply_pointer_is_visible (backend->pointer)) {
+                ply_trace ("First pointer motion, area %ldx%ld, renderer %s",
+                           (long) bounds.width, (long) bounds.height,
+                           backend->is_active ? "active" : "NOT active");
+                /* Drawn into the framebuffer by default, so it shows up everywhere the
+                 * splash does (VM windows, remote consoles, drivers without a cursor plane)
+                 */
+                if (ply_kernel_command_line_has_argument ("plymouth.hardware-pointer"))
+                        ply_trace ("Using the hardware cursor plane for the mouse pointer, as requested");
+                else
+                        backend->cursor_software = true;
+        }
+
+        ply_pointer_handle_motion (backend->pointer, event, &bounds);
+
+        update_cursor (backend);
+        notify_pointer (backend, PLY_RENDERER_POINTER_MOVED, 0);
+}
+
+static void
+set_pointer_handler (ply_renderer_backend_t         *backend,
+                     ply_renderer_pointer_handler_t  handler,
+                     void                           *user_data)
+{
+        backend->pointer_handler = handler;
+        backend->pointer_handler_user_data = user_data;
+}
