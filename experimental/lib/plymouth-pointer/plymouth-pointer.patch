+
+/* Displays sit at their own offset in the canvas that sprites live in, so a
+ * position on a head is that position plus the offset of the head's display.
+ */
+bool script_lib_sprite_head_to_canvas (script_lib_sprite_data_t *data,
+                                       ply_renderer_head_t      *head,
+                                       int                       x,
+                                       int                       y,
+                                       int                      *canvas_x,
+                                       int                      *canvas_y)
+{
+        ply_list_node_t *node;
+
+        ply_list_foreach (data->displays, node) {
+                script_lib_display_t *display = ply_list_node_get_data (node);
+
+                if (ply_pixel_display_get_renderer_head (display->pixel_display) != head)
+                        continue;
+
+                *canvas_x = x + display->x;
+                *canvas_y = y + display->y;
+                return true;
+        }
+
+        return false;
+}
