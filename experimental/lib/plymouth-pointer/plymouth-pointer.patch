+                                      ply_input_device_pointer_handler_t callback,
+                                      void                              *user_data)
+{
+        pointer_handler_closure_t *closure = malloc (sizeof(pointer_handler_closure_t));
+
+        closure->handler = callback;
+        closure->user_data = user_data;
+        ply_list_append_data (input_device->pointer_handlers, closure);
