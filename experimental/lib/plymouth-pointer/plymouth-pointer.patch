+/* Puts the pixels back from the pixel buffer, then draws the arrow on top in
+ * whatever pixel format the frame buffer uses.
+ */
+static void
+draw_pointer (ply_renderer_backend_t *backend,
+              ply_renderer_head_t    *head)
+{
+        ply_rectangle_t area;
+        long left, top, x, y;
+
+        if (head->map_address == MAP_FAILED)
+                return;
+
+        if (backend->pointer_drawn) {
+                backend->flush_area (backend, head, &backend->pointer_area);
+                backend->pointer_drawn = false;
+        }
+
+        if (!ply_pointer_is_visible (backend->pointer) ||
+            !ply_pointer_get_area_on_head (backend->pointer, &head->area, &left, &top, &area))
+                return;
+
+        for (y = area.y; y < (long) (area.y + area.height); y++) {
+                for (x = area.x; x < (long) (area.x + area.width); x++) {
+                        uint32_t pixel = ply_pointer_get_pixel (backend->pointer, x - left, y - top);
+                        uint_fast32_t device_pixel;
+
+                        if (!(pixel >> 24))
+                                continue;
+
+                        device_pixel = argb32_pixel_value_to_device_pixel_value (backend, pixel);
+                        memcpy (&head->map_address[y * backend->row_stride + x * backend->bytes_per_pixel],
+                                &device_pixel, backend->bytes_per_pixel);
+                }
+        }
+
+        backend->pointer_area = area;
+        backend->pointer_drawn = true;
+}
