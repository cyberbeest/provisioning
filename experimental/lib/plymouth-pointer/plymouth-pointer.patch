+                                   long                  *left,
+                                   long                  *top,
+                                   ply_rectangle_t       *visible);
+
+/* Draws the image into a mapped 32 bit XRGB scan-out buffer of a head.
+ * drawn gets the area that was written. Returns false if nothing was drawn.
+ */
+bool ply_pointer_draw_xrgb32 (ply_pointer_t         *pointer,
+                              const ply_rectangle_t *head_area,
+                              char                  *map_address,
+                              unsigned long          row_stride,
+                              ply_rectangle_t       *drawn);
+#endif
+
+#endif /* PLY_POINTER_H */
