+typedef struct
+{
+        ply_input_device_pointer_handler_t handler;
+        void                              *user_data;
+} pointer_handler_closure_t;
+
+static void
+send_pointer_event (ply_input_device_t        *input_device,
+                    const ply_pointer_event_t *event)
+{
+        ply_list_node_t *node, *next;
+
+        if (!input_device->pointer_event_seen) {
+                input_device->pointer_event_seen = true;
+                ply_trace ("First pointer event from '%s' (%d handlers)",
+                           libevdev_get_name (input_device->dev),
+                           ply_list_get_length (input_device->pointer_handlers));
+        }
+
+        for (node = ply_list_get_first_node (input_device->pointer_handlers); node != NULL; node = next) {
+                pointer_handler_closure_t *closure = ply_list_node_get_data (node);
+
+                next = ply_list_get_next_node (input_device->pointer_handlers, node);
+                closure->handler (closure->user_data, input_device, event);
+        }
+}
+
+static ply_pointer_kind_t
+detect_pointer_kind (struct libevdev *dev)
+{
+        if (libevdev_has_event_code (dev, EV_REL, REL_X) &&
+            libevdev_has_event_code (dev, EV_REL, REL_Y))
+                return PLY_POINTER_KIND_RELATIVE;
+
+        if (!libevdev_has_event_code (dev, EV_ABS, ABS_X) ||
+            !libevdev_has_event_code (dev, EV_ABS, ABS_Y))
+                return PLY_POINTER_KIND_NONE;
+
+        /* Joysticks and gamepads */
+        if (libevdev_has_event_code (dev, EV_KEY, BTN_JOYSTICK))
+                return PLY_POINTER_KIND_NONE;
+
+        /* Touchscreens and drawing tablets map straight onto the screen */
+        if (libevdev_has_property (dev, INPUT_PROP_DIRECT))
+                return PLY_POINTER_KIND_ABSOLUTE;
+
+        if (libevdev_has_event_code (dev, EV_KEY, BTN_TOOL_FINGER))
+                return PLY_POINTER_KIND_TOUCHPAD;
+
+        /* VM pointers (virtio, USB tablets) */
+        if (libevdev_has_event_code (dev, EV_KEY, BTN_LEFT) ||
+            libevdev_has_event_code (dev, EV_KEY, BTN_TOUCH))
+                return PLY_POINTER_KIND_ABSOLUTE;
+
+        return PLY_POINTER_KIND_NONE;
+}
+
+static double
+touchpad_scale (struct libevdev *dev,
+                int              axis)
+{
+        int resolution = libevdev_get_abs_resolution (dev, axis);
+        int range = libevdev_get_abs_maximum (dev, axis) - libevdev_get_abs_minimum (dev, axis);
+
+        /* Resolution is in units per mm. Without it, assume the pad is about 100mm across */
+        if (resolution > 0)
+                return TOUCHPAD_PIXELS_PER_MM / resolution;
+        if (range > 0)
+                return TOUCHPAD_PIXELS_PER_MM * 100.0 / range;
+        return 0.1;
+}
+
+static void
+setup_pointer (ply_input_device_t *input_device)
+{
+        input_device->pointer_kind = detect_pointer_kind (input_device->dev);
+
+        ply_trace ("Input device '%s' (%s): pointer kind %d (0 none, 1 relative, 2 absolute, 3 touchpad)",
+                   libevdev_get_name (input_device->dev), input_device->path, input_device->pointer_kind);
+
+        if (input_device->pointer_kind == PLY_POINTER_KIND_TOUCHPAD) {
+                input_device->touchpad_scale_x = touchpad_scale (input_device->dev, ABS_X);
+                input_device->touchpad_scale_y = touchpad_scale (input_device->dev, ABS_Y);
+        }
+}
+
+/* Mouse, tablet and touch buttons; a touch only counts as a click on devices where
+ * touching the surface means pressing at that spot (a touchpad clicks with BTN_LEFT)
+ */
+static bool
+is_pointer_button (ply_input_device_t *input_device,
+                   int                 code)
+{
+        if (code >= BTN_MISC && code < BTN_JOYSTICK)
+                return true;
+
+        return code == BTN_TOUCH && input_device->pointer_kind == PLY_POINTER_KIND_ABSOLUTE;
+}
+
+static double
+normalized_abs_position (ply_input_device_t *input_device,
+                         int                 axis)
+{
+        int min = libevdev_get_abs_minimum (input_device->dev, axis);
+        int max = libevdev_get_abs_maximum (input_device->dev, axis);
+
+        if (max <= min)
+                return 0.0;
+
+        return (libevdev_get_event_value (input_device->dev, EV_ABS, axis) - min) / (double) (max - min);
+}
+
+static void
+send_pending_pointer_motion (ply_input_device_t *input_device)
+{
+        ply_pointer_event_t event = { .type = PLY_POINTER_EVENT_MOTION };
+
+        if (!input_device->pending_motion)
+                return;
+
+        event.absolute = input_device->pointer_kind == PLY_POINTER_KIND_ABSOLUTE;
+        event.x = input_device->pending_x;
+        event.y = input_device->pending_y;
+
+        input_device->pending_motion = false;
+        if (!event.absolute)
+                input_device->pending_x = input_device->pending_y = 0;
+
+        send_pointer_event (input_device, &event);
+}
+
+/* The other tool buttons: pen tools, mouse, lens, and two to five fingers */
+static bool
+is_other_tool_button (int code)
+{
+        return (code >= BTN_TOOL_PEN && code <= BTN_TOOL_QUINTTAP && code != BTN_TOOL_FINGER) ||
+               (code >= BTN_TOOL_DOUBLETAP && code <= BTN_TOOL_QUADTAP);
+}
+
+static void
+handle_touchpad_report (ply_input_device_t *input_device)
+{
+        int x, y;
+
+        if (!input_device->touchpad_one_finger)
+                return;
+
+        /* The device state has the finger position even when this report did not repeat it,
+         * which matters at the start of a stroke (e.g. going from two fingers to one)
+         */
+        x = libevdev_get_event_value (input_device->dev, EV_ABS, ABS_X);
+        y = libevdev_get_event_value (input_device->dev, EV_ABS, ABS_Y);
+
+        if (input_device->touchpad_has_last && (x != input_device->touchpad_last_x || y != input_device->touchpad_last_y)) {
+                input_device->pending_x += (x - input_device->touchpad_last_x) * input_device->touchpad_scale_x;
+                input_device->pending_y += (y - input_device->touchpad_last_y) * input_device->touchpad_scale_y;
+                input_device->pending_motion = true;
+        }
+
+        input_device->touchpad_last_x = x;
+        input_device->touchpad_last_y = y;
+        input_device->touchpad_has_last = true;
+}
+
+static void
+handle_pointer_event (ply_input_device_t *input_device,
+                      struct input_event *ev)
+{
+        if (ply_list_get_length (input_device->pointer_handlers) == 0)
+                return;
+
+        if (ev->type == EV_REL && input_device->pointer_kind == PLY_POINTER_KIND_RELATIVE) {
+                if (ev->code == REL_X)
+                        input_device->pending_x += ev->value;
+                else if (ev->code == REL_Y)
+                        input_device->pending_y += ev->value;
+                else
+                        return;
+                input_device->pending_motion = true;
+        } else if (ev->type == EV_ABS && (ev->code == ABS_X || ev->code == ABS_Y)) {
+                if (input_device->pointer_kind == PLY_POINTER_KIND_ABSOLUTE) {
+                        input_device->pending_x = normalized_abs_position (input_device, ABS_X);
+                        input_device->pending_y = normalized_abs_position (input_device, ABS_Y);
+                        input_device->pending_motion = true;
+                }
+        } else if (ev->type == EV_SYN && ev->code == SYN_REPORT) {
+                if (input_device->pointer_kind == PLY_POINTER_KIND_TOUCHPAD)
+                        handle_touchpad_report (input_device);
+                send_pending_pointer_motion (input_device);
+        } else if (ev->type == EV_KEY) {
+                if (input_device->pointer_kind == PLY_POINTER_KIND_TOUCHPAD &&
+                    (ev->code == BTN_TOOL_FINGER || (ev->value != 0 && is_other_tool_button (ev->code)))) {
+                        /* One finger moves the pointer. Any other count of fingers (or a lifted
+                         * finger) ends the stroke, and the next one starts fresh so the pointer
+                         * does not jump. The kernel reports going from several fingers to one as
+                         * BTN_TOOL_FINGER on and then the other tool off, so only turning a tool
+                         * on can end the single finger state.
+                         */
+                        input_device->touchpad_one_finger = ev->code == BTN_TOOL_FINGER && ev->value != 0;
+                        input_device->touchpad_has_last = false;
+                } else if (is_pointer_button (input_device, ev->code) && ev->value != 2) {
+                        ply_pointer_event_t event = {
+                                .type = PLY_POINTER_EVENT_BUTTON,
+                                .button = ev->code,
+                                .pressed = ev->value == 1,
+                        };
+
+                        send_pending_pointer_motion (input_device);
+                        send_pointer_event (input_device, &event);
+                }
+        }
+}
