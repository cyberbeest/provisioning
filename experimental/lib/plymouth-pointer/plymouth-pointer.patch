+void
+ply_input_device_remove_pointer_handler (ply_input_device_t                *input_device,
+                                         ply_input_device_pointer_handler_t callback,
+                                         void                              *user_data)
+{
+        ply_list_node_t *node;
+
+        for (node = ply_list_get_first_node (input_device->pointer_handlers); node != NULL;
+             node = ply_list_get_next_node (input_device->pointer_handlers, node)) {
+                pointer_handler_closure_t *closure = ply_list_node_get_data (node);
+
+                if (closure->handler == callback && closure->user_data == user_data) {
+                        free (closure);
+                        ply_list_remove_node (input_device->pointer_handlers, node);
