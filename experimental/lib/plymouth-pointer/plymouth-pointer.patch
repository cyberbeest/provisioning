+                script_lib_plymouth_on_pointer_motion (plugin->script_state,
+                                                       plugin->script_plymouth_lib,
+                                                       canvas_x, canvas_y);
+        else
+                script_lib_plymouth_on_pointer_button (plugin->script_state,
+                                                       plugin->script_plymouth_lib,
+                                                       button,
+                                                       action == PLY_RENDERER_POINTER_PRESSED,
+                                                       canvas_x, canvas_y);
+}
