+                             int            max_height);
+
+/* Where the image lands on a head: the position of its top left corner (may be
+ * negative) and the part that is visible, all relative to the head. Returns
+ * false if the pointer is not on this head.
+ */
+bool ply_pointer_is_on_head (ply_pointer_t         *pointer,
