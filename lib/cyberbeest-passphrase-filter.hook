#!/bin/sh
# Installed as /etc/initramfs-tools/hooks/cyberbeest-passphrase-filter. The
# cryptroot hook only copies the crypttab keyscript itself, so the shared
# filter that keyscript sources has to be copied in separately.
PREREQ="cryptroot"
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
prereqs) prereqs; exit 0 ;;
esac
. /usr/share/initramfs-tools/hook-functions
copy_file script /lib/cryptsetup/cyberbeest-passphrase-filter /lib/cryptsetup/cyberbeest-passphrase-filter
