[Unit]
Description=Remembers the host names behind IP addresses for the network connections window (opt-in, memory only)

[Service]
User=cyberbeest-dnswatch
Group=__GROUP__
Environment=DNS_WATCH_UID=__UID__
ExecStart=/usr/bin/python3 /usr/local/lib/cyberbeest-dns-watch/cyberbeest-dns-watch.py
RuntimeDirectory=cyberbeest-dns-watch
RuntimeDirectoryMode=0750
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_PACKET
RestrictNamespaces=true
MemoryMax=64M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
