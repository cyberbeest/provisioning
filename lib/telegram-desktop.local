# Downloads and Pictures sharing is managed by Cyberbeest Shared Folders
# (44a-shared-folders.sh) via ~/.config/firejail/globals.local.

# Links: the jail cannot start a browser itself (no nested firejail), so let
# Telegram ask the host's OpenURI portal to open them in the sandboxed browser.
dbus-user.talk org.freedesktop.portal.Desktop
private-bin gdbus
