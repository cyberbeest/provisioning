#!/usr/bin/env python3
"""Fades in a small wallpaper-settings button when the mouse rests in the
bottom-right corner of the bare desktop; clicking it opens Cyberbeest Settings
on the "Wallpaper rotation" tab.

Cost: one pointer query every POLL_MS (a single X round trip, nothing else).
Window lookups and the screensaver check only happen while the pointer is
inside the corner zone.

There is no compositor, so real window transparency is not available. The
fade is drawn by hand instead: the button window shows a screenshot of the
wallpaper behind it with the icon blended in at the current opacity.
"""
import fcntl
import os
import subprocess
import sys
import urllib.parse

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Wnck
import cairo

sys.path.insert(0, os.path.expanduser("~/.local/bin"))
try:
    from i18n import t
except Exception:
    def t(key):
        return key

TIP_FALLBACK = "Wallpaper rotation settings"
PACKS = ("nature", "space", "architecture", "cars", "cities", "coast", "art")
MARKER = os.path.expanduser("~/.config/cyberbeest/wallpaper-rotation")


CREDITS = "/usr/share/backgrounds/cyberbeest/CREDITS.md"


def current_image(display, x, y):
    """Path of the picture on the monitor at (x, y), from xfdesktop's settings."""
    mon = display.get_monitor_at_point(x, y)
    names = [mon.get_model() or ""]
    base = "/backdrop/screen0/monitor{}/workspace0/last-image"
    for name in names:
        r = subprocess.run(["xfconf-query", "-c", "xfce4-desktop", "-p", base.format(name)],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return ""


def credit_for(image):
    """(title, author, license, url) of a pack picture from CREDITS.md, or None."""
    if not image.startswith("/usr/share/backgrounds/cyberbeest/"):
        return None
    name = os.path.basename(image)
    try:
        lines = open(CREDITS).read().splitlines()
    except OSError:
        return None
    for line in lines:
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) >= 4 and cells[0] == name:
            title = urllib.parse.unquote(cells[3].rsplit("File:", 1)[-1])
            title = os.path.splitext(title)[0].replace("_", " ")
            return title, cells[1], cells[2], cells[3]
    return None


def tip_text(display=None, x=0, y=0):
    """Tooltip: the active photo pack, read fresh each time the button appears."""
    try:
        pack = open(MARKER).read().strip()
    except OSError:
        pack = ""
    key = "wallpaper.corner_tip_on" if pack in PACKS else "wallpaper.corner_tip_off"
    text = t(key)
    if text == key:
        return TIP_FALLBACK
    if pack not in PACKS:
        return text
    name = t("wallpaper." + pack)
    text = text.format(pack=name if name != "wallpaper." + pack else pack)
    credit = credit_for(current_image(display, x, y)) if display else None
    now = t("wallpaper.corner_now")
    if credit and now != "wallpaper.corner_now":
        text += "\n" + now.format(title=credit[0], author=credit[1], license=credit[2])
    return text


SETTINGS = os.path.expanduser("~/.local/bin/cyberbeest-settings.py")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
LOCK = os.path.join(RUNTIME, "cyberbeest-wallpaper-corner.lock")

POLL_MS = 300       # pointer check interval
ZONE = 140          # px: hover zone edge, measured from the work-area corner
SIZE = 48           # px: button window edge
MARGIN = 12         # px: gap between button and the screen/panel edge
FADE_MS = 220
WA_CACHE_S = 5       # how long a monitor's panel-adjusted work area is reused
TIP_DELAY_MS = 1000   # the tooltip is big, so it should not pop up on a stray hover
TIP_SHOW_MS = 7000    # ...and it goes away by itself
FADE_FRAME_MS = 30
LEAVE_GRACE = 2     # polls the pointer may stay outside the zone before fading out


class Corner:
    def __init__(self):
        self.display = Gdk.Display.get_default()
        self.pointer = self.display.get_default_seat().get_pointer()
        self.screen = Wnck.Screen.get_default()
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.win = None
        self.alpha = 0.0
        self.target = 0.0
        self.fade_id = 0
        self.outside = 0
        self.bg = None          # pixbuf of the wallpaper behind the button
        self.icon = None
        self.hover = False
        self.menu_open = False
        self.wa_cache = {}
        self.tip_win = None
        self.tip_timer = 0

    # -- geometry / visibility checks (only run while the pointer is in the zone)

    def work_area(self, x, y):
        """Usable area of the monitor at (x, y), minus panels (dock windows).

        GTK only subtracts panels on the primary monitor, so on a second
        monitor the corner would land under its panel and the window manager
        would nudge the button away from the spot its background was grabbed
        from. Cached for a few seconds: this runs on every poll.
        """
        mon = self.display.get_monitor_at_point(x, y)
        key = mon.get_geometry().x, mon.get_geometry().y
        now = GLib.get_monotonic_time() // 1000000
        hit = self.wa_cache.get(key)
        if hit and now - hit[0] < WA_CACHE_S:
            return hit[1]
        g = mon.get_geometry()
        left, top, right, bottom = g.x, g.y, g.x + g.width, g.y + g.height
        self.screen.force_update()
        for w in self.screen.get_windows():
            if w.get_window_type() != Wnck.WindowType.DOCK or w.is_minimized():
                continue
            dx, dy, dw, dh = w.get_geometry()
            if dx >= g.x + g.width or dx + dw <= g.x or dy >= g.y + g.height or dy + dh <= g.y:
                continue  # on another monitor
            if dw >= dh:  # horizontal panel
                if dy + dh / 2 > (top + bottom) / 2:
                    bottom = min(bottom, dy)
                else:
                    top = max(top, dy + dh)
            else:         # vertical panel
                if dx + dw / 2 > (left + right) / 2:
                    right = min(right, dx)
                else:
                    left = max(left, dx + dw)
        area = Gdk.Rectangle()
        area.x, area.y, area.width, area.height = left, top, right - left, bottom - top
        self.wa_cache[key] = (now, area)
        return area

    def screensaver_active(self):
        try:
            r = self.bus.call_sync("org.xfce.ScreenSaver", "/org/xfce/ScreenSaver",
                                   "org.xfce.ScreenSaver", "GetActive", None,
                                   GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 1000, None)
            return r.unpack()[0]
        except GLib.Error:
            return False

    def covered(self, x, y):
        """True if a normal window sits under the point (desktop not bare)."""
        self.screen.force_update()
        ws = self.screen.get_active_workspace()
        for w in self.screen.get_windows():
            if w.is_minimized():
                continue
            if w.get_window_type() in (Wnck.WindowType.DESKTOP, Wnck.WindowType.DOCK):
                continue
            if ws is not None and not w.is_on_workspace(ws):
                continue
            gx, gy, gw, gh = w.get_geometry()
            if gx <= x < gx + gw and gy <= y < gy + gh:
                return True
        return False

    # -- button window

    def build_window(self, wa, x, y):
        # A managed (not override-redirect) window, so it can be stacked below
        # the normal windows like a desktop icon instead of floating above them.
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_accept_focus(False)
        win.set_focus_on_map(False)
        win.set_keep_below(True)
        win.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        win.set_size_request(SIZE, SIZE)
        win.set_default_size(SIZE, SIZE)
        win.set_app_paintable(True)
        win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                       | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.tip = tip_text(self.display, x, y)
        win.connect("draw", self.on_draw)
        win.connect("button-press-event", self.on_click)
        win.connect("enter-notify-event", self.on_enter)
        win.connect("leave-notify-event", self.on_leave)
        win.move(wa.x + wa.width - SIZE - MARGIN, wa.y + wa.height - SIZE - MARGIN)
        return win

    def grab_background(self, wa):
        """Screenshot of the wallpaper where the button will sit."""
        x, y = wa.x + wa.width - SIZE - MARGIN, wa.y + wa.height - SIZE - MARGIN
        root = Gdk.get_default_root_window()
        return Gdk.pixbuf_get_from_window(root, x, y, SIZE, SIZE)

    def load_icon(self):
        theme = Gtk.IconTheme.get_default()
        for name in ("preferences-desktop-wallpaper", "preferences-desktop-display",
                     "preferences-system"):
            try:
                return theme.load_icon(name, SIZE - 20, Gtk.IconLookupFlags.FORCE_SIZE)
            except GLib.Error:
                continue
        return None

    def on_draw(self, _win, cr):
        if self.bg is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.bg, 0, 0)
            cr.paint()
        a = self.alpha
        # Round dark badge, brighter under the pointer.
        cr.arc(SIZE / 2, SIZE / 2, SIZE / 2 - 2, 0, 6.2832)
        shade = 0.30 if self.hover else 0.12
        cr.set_source_rgba(shade, shade, shade + 0.04, 0.85 * a)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.55 * a)
        cr.set_line_width(1.5)
        cr.stroke()
        if self.icon is not None:
            off = (SIZE - self.icon.get_width()) / 2
            Gdk.cairo_set_source_pixbuf(cr, self.icon, off, off)
            cr.paint_with_alpha(a)
        return True

    # The tooltip is our own window rather than a GTK tooltip: it is large, so it
    # appears only after the pointer has rested on the button for a while and
    # disappears again by itself.

    def on_enter(self, win, *_):
        self.hover = True
        self.cancel_tip()
        self.tip_timer = GLib.timeout_add(TIP_DELAY_MS, self.show_tip, win)

    def on_leave(self, _win, *_):
        self.hover = False
        self.cancel_tip()

    def show_tip(self, win):
        self.tip_timer = GLib.timeout_add(TIP_SHOW_MS, self.hide_tip)
        # Managed window in the "below" layer, like the button: other windows
        # cover it instead of it covering them.
        tip = self.tip_win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        tip.set_decorated(False)
        tip.set_resizable(False)
        tip.set_skip_taskbar_hint(True)
        tip.set_skip_pager_hint(True)
        tip.set_accept_focus(False)
        tip.set_focus_on_map(False)
        tip.set_keep_below(True)
        tip.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        label = Gtk.Label(label=self.tip)
        label.set_margin_top(6)
        label.set_margin_bottom(6)
        label.set_margin_start(10)
        label.set_margin_end(10)
        tip.add(label)
        css = Gtk.CssProvider()
        css.load_from_data(b"window { background: #1c1c1c; border-radius: 4px; }"
                           b"label { color: #f2f2f2; }")
        tip.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        label.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        label.show()
        w, h = tip.get_preferred_size()[1].width, tip.get_preferred_size()[1].height
        tip.set_size_request(w, h)
        wx, wy = win.get_position()
        tip.move(max(0, wx + SIZE - w), max(0, wy - h - 6))
        tip.show_all()
        return False

    def hide_tip(self):
        self.tip_timer = 0
        if self.tip_win is not None:
            self.tip_win.destroy()
            self.tip_win = None
        return False

    def cancel_tip(self):
        if self.tip_timer:
            GLib.source_remove(self.tip_timer)
            self.tip_timer = 0
        self.hide_tip()

    def on_click(self, _win, ev):
        self.cancel_tip()
        if ev.button == 3:
            self.show_menu(ev)
            return True
        self.open_settings()
        self.set_target(0.0)
        return True

    def show_menu(self, ev):
        """Right-click: settings, and for the current picture: reveal it (any
        picture) or open its source page (pack photos)."""
        entries = []
        image = current_image(self.display, int(ev.x_root), int(ev.y_root))
        if image and os.path.isfile(image) and not image.startswith(RUNTIME):
            entries.append((t("wallpaper.corner_menu_folder"), lambda *_: self.reveal(image)))
            credit = credit_for(image)
            if credit:
                entries.append((t("wallpaper.corner_menu_site"), lambda *_: self.open_url(credit[3])))
            entries.append((None, None))
        entries.append((t("wallpaper.corner_tip"), self.open_settings))
        menu = Gtk.Menu()
        for label, action in entries:
            if label is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            item = Gtk.MenuItem(label=label)
            item.connect("activate", action)
            menu.append(item)
        menu.show_all()
        self.menu_open = True
        menu.connect("deactivate", lambda *_: setattr(self, "menu_open", False))
        menu.popup_at_pointer(ev)

    def open_settings(self, *_):
        subprocess.Popen([SETTINGS, "--tab=wallpaper"], start_new_session=True)

    def reveal(self, image):
        uri = GLib.filename_to_uri(image, None)
        r = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.FileManager1",
                            "--object-path", "/org/freedesktop/FileManager1",
                            "--method", "org.freedesktop.FileManager1.ShowItems",
                            f"['{uri}']", ""], capture_output=True)
        if r.returncode != 0:
            subprocess.Popen(["thunar", os.path.dirname(image)], start_new_session=True)

    def open_url(self, url):
        if url.startswith("https://"):
            subprocess.Popen(["firefox", url], start_new_session=True)

    # -- fading

    def set_target(self, target):
        if target == self.target:
            return
        self.target = target
        if target > 0 and self.win is None:
            return
        if not self.fade_id:
            self.fade_id = GLib.timeout_add(FADE_FRAME_MS, self.fade_step)

    def fade_step(self):
        step = FADE_FRAME_MS / FADE_MS
        if self.alpha < self.target:
            self.alpha = min(self.target, self.alpha + step)
        else:
            self.alpha = max(self.target, self.alpha - step)
        if self.win is not None:
            self.win.queue_draw()
        if self.alpha == self.target:
            self.fade_id = 0
            if self.alpha == 0 and self.win is not None:
                self.cancel_tip()
                self.win.destroy()
                self.win = None
                self.bg = None
            return False
        return True

    def show(self, wa, x, y):
        if self.win is None:
            self.bg = self.grab_background(wa)
            if self.icon is None:
                self.icon = self.load_icon()
            self.alpha = 0.0
            self.win = self.build_window(wa, x, y)
            self.win.show_all()
        self.outside = 0
        self.set_target(1.0)

    # -- poll

    def poll(self):
        _, x, y = self.pointer.get_position()
        wa = self.work_area(x, y)
        in_zone = x >= wa.x + wa.width - ZONE and y >= wa.y + wa.height - ZONE \
            and x < wa.x + wa.width and y < wa.y + wa.height
        if in_zone:
            if self.win is None or self.target == 0.0:
                if not self.covered(x, y) and not self.screensaver_active():
                    self.show(wa, x, y)
            else:
                self.outside = 0
        elif self.win is not None and self.target > 0:
            self.outside += 1
            if self.outside >= LEAVE_GRACE and not self.hover and not self.menu_open:
                self.set_target(0.0)
        return True

    def run(self):
        GLib.timeout_add(POLL_MS, self.poll)
        Gtk.main()


def main():
    lock = open(LOCK, "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # already running
    Corner().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
