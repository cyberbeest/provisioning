# cyberbeest.script - minimal boot splash: logo stays visible through
# boot animation, password/LUKS prompts, and shutdown/reboot.

# Reboot uses --mode=reboot, poweroff/halt/kexec use --mode=shutdown --
# both are "going down", so both get the shutdown watermark/text and are
# never affected by bright mode (that's an unlock-prompt-only thing; the
# shutdown screen always stays dark).
is_going_down = Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot";

# Substituted at install time to "0" and rewritten in place (in the installed
# theme, then the initramfs rebuilt) by
# /usr/local/sbin/cyberbeest-set-boot-bright-mode when the owner toggles it
# via disk_password_gui.py's "Boot Screen" tab -- a bright screen at the
# unlock prompt doubles as a poor man's flashlight for typing in the dark.
bright_mode = "__BRIGHT_MODE__";
bright_active = bright_mode == "1" && !is_going_down;

# Substituted at install time to "1" by enable-passphrase-words.sh once the
# crypttab keyscript that normalizes what is typed (cyberbeest-askpass-words:
# lower case, any run of separators becomes one "-") is wired in. Only then
# does the unlock prompt show "words typed + bullets for the current word"
# instead of one bullet per key -- the display must never promise
# normalization the keyscript does not actually perform.
word_mode = "__WORD_MODE__";

if (bright_active) {
    # Matches cyberbeest-for-print.png's own near-white background so the
    # logo blends in with no visible box around it.
    Window.SetBackgroundTopColor(0.996, 0.996, 0.996);
    Window.SetBackgroundBottomColor(0.996, 0.996, 0.996);
    text_red = 0;
    text_green = 0;
    text_blue = 0;
} else {
    Window.SetBackgroundTopColor(0, 0, 0);
    Window.SetBackgroundBottomColor(0, 0, 0);
    text_red = 1;
    text_green = 1;
    text_blue = 1;
}

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# ---------------------------------------------------------------------
# Logo watermark - always on screen, sized relative to the display
# ---------------------------------------------------------------------
logo_target_h = screen.h * 0.42;
if (is_going_down)
    logo.image = Image("watermark-shutdown.png");
else if (bright_active)
    logo.image = Image("cyberbeest-for-print.png");
else
    logo.image = Image("watermark.png");
logo_scale = logo_target_h / logo.image.GetHeight();
logo.image = logo.image.Scale(logo.image.GetWidth() * logo_scale, logo_target_h);
logo.sprite = Sprite(logo.image);
logo.x = screen.w / 2 - logo.image.GetWidth() / 2;
logo.y = screen.h * 0.38 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(1);

# ---------------------------------------------------------------------
# Throbber animation, centered below the logo
# ---------------------------------------------------------------------
throbber_frame_count = 30;
for (i = 1; i <= throbber_frame_count; i++) {
    if (i < 10)
        throbber.image[i] = Image("throbber-000" + i + ".png");
    else
        throbber.image[i] = Image("throbber-00" + i + ".png");
}

throbber.sprite = Sprite();
throbber.sprite.SetImage(throbber.image[1]);
throbber.width = throbber.image[1].GetWidth();
throbber.height = throbber.image[1].GetHeight();
throbber.x = screen.w / 2 - throbber.width / 2;
throbber.y = screen.h * 0.72 - throbber.height / 2;
throbber.sprite.SetX(throbber.x);
throbber.sprite.SetY(throbber.y);
throbber.sprite.SetZ(10);

throbber.current_frame = 1;
throbber.frame_skip = 0;

# ---------------------------------------------------------------------
# Shutdown status text. Substituted at install time
# (setup-grub-plymouth-theme.sh) from lib/i18n's plymouth.shutdown_text
# key, same as the LUKS prompt above -- plymouth's shutdown mode reads
# this script live from disk, but the locale it should use is resolved
# once at provisioning time, not looked up at shutdown.
if (is_going_down) {
    shutdown_text_image = Image.Text("__SHUTDOWN_TEXT__", 1, 1, 1);
    shutdown_text_sprite = Sprite(shutdown_text_image);
    shutdown_text_sprite.SetX(screen.w / 2 - shutdown_text_image.GetWidth() / 2);
    shutdown_text_sprite.SetY(screen.h * 0.82);
    shutdown_text_sprite.SetZ(20);
    shutdown_text_sprite.SetOpacity(1);
}

fun refresh_callback() {
    throbber.frame_skip++;
    if (throbber.frame_skip >= 2) {
        throbber.frame_skip = 0;
        throbber.current_frame++;
        if (throbber.current_frame > throbber_frame_count)
            throbber.current_frame = 1;
        throbber.sprite.SetImage(throbber.image[throbber.current_frame]);
    }

    if (message.hide_countdown > 0) {
        message.hide_countdown--;
        if (message.hide_countdown == 0)
            message.sprite.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------------------------------------------------------------------
# Password / LUKS unlock dialog
# ---------------------------------------------------------------------
password_dialog.entry_image = Image("entry.png");
password_dialog.bullet_image = Image("bullet.png");
password_dialog.lock_image = Image("lock.png");

# Substituted at install time to "" and rewritten in place (in the installed
# theme, then the initramfs rebuilt) by /usr/local/sbin/cyberbeest-set-boot-name
# when the owner sets a display name via disk_password_gui.py's "Boot Screen"
# tab. Bare name text, with no "= =" wrapping -- it's rendered as its own,
# larger-font sprite above the LUKS prompt rather than folded into it.
password_dialog.machine_name = "__MACHINE_NAME__";

fun password_dialog_setup(prompt) {
    local = password_dialog;
    local.name_sprite = NULL;

    # Substituted at install time (setup-grub-plymouth-theme.sh) from
    # lib/i18n's plymouth.luks_prompt key, based on the locale active when
    # provisioning last ran -- plymouth runs before any filesystem holding
    # /etc/default/locale is even decrypted, so this can't be looked up live
    # at boot the way the desktop-session strings are.
    if (prompt == NULL || prompt == "") {
        prompt = "__LUKS_PROMPT__";
        if (local.machine_name != "") {
            local.name_image = Image.Text(local.machine_name, text_red, text_green, text_blue, 1, "Sans Bold 26", "center");
            local.name_sprite = Sprite(local.name_image);
        }
    }
    # align="center" so a shorter line centers over a longer one instead of
    # both being left-justified.
    local.prompt_image = Image.Text(prompt, text_red, text_green, text_blue, 1, NULL, "center");
    local.prompt_sprite = Sprite(local.prompt_image);
    local.prompt_x = screen.w / 2 - local.prompt_image.GetWidth() / 2;
    # Anchored to the prompt text's own height (plus a fixed gap) rather
    # than the entry box's height, so this doesn't creep down into the
    # entry box.
    local.prompt_gap = 24;
    local.prompt_y = screen.h * 0.82 - local.prompt_image.GetHeight() - local.prompt_gap;
    local.prompt_sprite.SetX(local.prompt_x);
    local.prompt_sprite.SetY(local.prompt_y);
    local.prompt_sprite.SetZ(20);

    if (local.name_sprite) {
        local.name_x = screen.w / 2 - local.name_image.GetWidth() / 2;
        # A blank line's worth of extra space (using the prompt's own line
        # height as the unit) between the name and the prompt below it.
        local.name_sprite_gap = local.prompt_image.GetHeight();
        local.name_y = local.prompt_y - local.name_image.GetHeight() - local.name_sprite_gap;
        local.name_sprite.SetX(local.name_x);
        local.name_sprite.SetY(local.name_y);
        local.name_sprite.SetZ(20);
    }

    # Center the lock+entry cluster as a single unit (rather than centering
    # the entry box alone and hanging the lock off its left edge), so its
    # visual center lines up with the prompt text centered above it.
    local.gap = 8;
    local.group_w = local.lock_image.GetWidth() + local.gap + local.entry_image.GetWidth();
    local.group_x = screen.w / 2 - local.group_w / 2;
    local.entry_y = screen.h * 0.82;

    local.lock_sprite = Sprite(local.lock_image);
    local.lock_sprite.SetX(local.group_x);
    local.lock_sprite.SetY(local.entry_y + local.entry_image.GetHeight() / 2 - local.lock_image.GetHeight() / 2);
    local.lock_sprite.SetZ(20);

    local.entry_x = local.group_x + local.lock_image.GetWidth() + local.gap;
    local.entry_sprite = Sprite(local.entry_image);
    local.entry_sprite.SetX(local.entry_x);
    local.entry_sprite.SetY(local.entry_y);
    local.entry_sprite.SetZ(20);

    # "Boot Fresh" button -- created once like everything else above, but
    # only ever made visible by redraw_boot_fresh() when a hibernation
    # image is actually pending. See that function and
    # update_status_callback() below.
    local.boot_fresh_y = local.entry_y + local.entry_image.GetHeight() + 24;
    local.boot_fresh_sprite = Sprite();
    local.boot_fresh_sprite.SetY(local.boot_fresh_y);
    local.boot_fresh_sprite.SetZ(20);
    local.boot_fresh_sprite.SetOpacity(0);

    global.password_dialog = local;
}

# ---------------------------------------------------------------------
# Passphrase entry display
#
# plain_draw: stock behaviour, one bullet per typed character.
#
# word_draw: the passphrase is "word-word-word". The keyscript turns
# whatever the owner types into exactly that (lower case; any run of
# separator characters, i.e. space . , _ - and the other ASCII punctuation,
# becomes a single "-"; leading and trailing separators are dropped), so
# the field shows one check mark per COMPLETED word followed by one bullet per
# character of the word being typed. Typing a separator turns the bullets
# into a check mark, which is the feedback that the word boundary was accepted.
#
# The script only gets the bullet COUNT from Plymouth, never the text, and
# Plymouth does not forward backspace / Ctrl+U to scripts at all. So the
# typed keys are mirrored in word_typed[] from the keyboard callback and
# truncated to the bullet count whenever Plymouth reports a shorter buffer
# (backspace, line erase, Enter).
# ---------------------------------------------------------------------
word_sep_chars = " !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
# NOTE: this script language has no true/false keywords (they are undefined
# names that evaluate to NULL), so flags and return values below are 1/0.
# Defined here, at top level: assigning to an undefined name inside a
# function makes a function-local variable that is gone on return.
word_typed[0] = "";
word_typed_n = 0;
word_prompt_active = 0;
word_ctrl_f = "";

fun word_is_sep(c) {
    # Multi-byte (non-ASCII) keys are word characters, same as the keyscript.
    if (c.Length() != 1)
        return 0;
    for (wsi = 0; wsi < word_sep_chars.Length(); wsi++) {
        if (word_sep_chars.CharAt(wsi) == c)
            return 1;
    }
    return 0;
}

fun word_note_key(c) {
    # Ctrl+F is forwarded to the script but never enters Plymouth's buffer.
    if (c == word_ctrl_f)
        return;
    word_typed[word_typed_n] = c;
    word_typed_n++;
    # Plymouth calls the display-password callback (with the new bullet
    # count) BEFORE it hands the key to this callback, so that redraw ran
    # on a mirror one key short. Redraw again now that the key is in.
    if (word_mode == "1" && word_prompt_active)
        word_draw(word_typed_n);
}

fun word_sync(bullets) {
    for (wsi = word_typed_n; wsi > bullets; wsi--)
        word_typed[wsi - 1] = NULL;
    if (word_typed_n > bullets)
        word_typed_n = bullets;
}

fun word_draw(bullets) {
    word_sync(bullets);

    # Count completed words and the length of the word in progress.
    done = 0;
    cur = 0;
    for (wi = 0; wi < word_typed_n; wi++) {
        if (word_is_sep(word_typed[wi])) {
            if (cur > 0) {
                done++;
                cur = 0;
            }
        } else {
            cur++;
        }
    }

    bw = password_dialog.bullet_image.GetWidth();
    bh = password_dialog.bullet_image.GetHeight();
    # Completed-word marker: a check mark (U+2713, in the initramfs font).
    # Always white: the entry field is dark in bright mode too, so the
    # theme's (black, in bright mode) text color would vanish on it.
    # It only says "a word boundary was accepted" -- nothing about the word
    # being correct, which is never known until the disk actually unlocks.
    if (!password_dialog.pill_image)
        password_dialog.pill_image = Image.Text("✓", 1, 1, 1, 1, "Sans Bold 15");
    pill_w = password_dialog.pill_image.GetWidth();
    pill_h = password_dialog.pill_image.GetHeight();
    pill_gap = bw;

    avail = password_dialog.entry_image.GetWidth() - 2 * bw;
    # Never let the row outgrow the entry box: drop bullets of the current
    # word first (the pills are the part worth keeping visible).
    pills_w = done * (pill_w + pill_gap);
    if (pills_w > avail) {
        done = Math.Int(avail / (pill_w + pill_gap));
        pills_w = done * (pill_w + pill_gap);
    }
    max_cur = Math.Int((avail - pills_w) / bw);
    if (cur > max_cur)
        cur = max_cur;

    row_width = pills_w + cur * bw;
    if (row_width > 0 && cur == 0)
        row_width = row_width - pill_gap;
    row_x = password_dialog.entry_x + password_dialog.entry_image.GetWidth() / 2 - row_width / 2;
    mid_y = password_dialog.entry_y + password_dialog.entry_image.GetHeight() / 2;

    for (wi = 0; password_dialog.pill_sprite[wi] || wi < done; wi++) {
        if (!password_dialog.pill_sprite[wi]) {
            password_dialog.pill_sprite[wi] = Sprite(password_dialog.pill_image);
            password_dialog.pill_sprite[wi].SetZ(21);
        }
        if (wi < done) {
            password_dialog.pill_sprite[wi].SetX(row_x + wi * (pill_w + pill_gap));
            password_dialog.pill_sprite[wi].SetY(mid_y - pill_h / 2);
            password_dialog.pill_sprite[wi].SetOpacity(1);
        } else {
            password_dialog.pill_sprite[wi].SetOpacity(0);
        }
    }

    for (wi = 0; password_dialog.bullet_sprite[wi] || wi < cur; wi++) {
        if (!password_dialog.bullet_sprite[wi]) {
            password_dialog.bullet_sprite[wi] = Sprite(password_dialog.bullet_image);
            password_dialog.bullet_sprite[wi].SetZ(21);
        }
        if (wi < cur) {
            password_dialog.bullet_sprite[wi].SetX(row_x + pills_w + wi * bw);
            password_dialog.bullet_sprite[wi].SetY(mid_y - bh / 2);
            password_dialog.bullet_sprite[wi].SetOpacity(1);
        } else {
            password_dialog.bullet_sprite[wi].SetOpacity(0);
        }
    }
}

fun plain_draw(bullets) {
    bullet_w = password_dialog.bullet_image.GetWidth();
    max_bullets = Math.Int(password_dialog.entry_image.GetWidth() / bullet_w) - 1;
    if (bullets > max_bullets)
        bullets = max_bullets;

    bullet_y = password_dialog.entry_y + password_dialog.entry_image.GetHeight() / 2
               - password_dialog.bullet_image.GetHeight() / 2;
    row_width = bullets * bullet_w;
    row_x = password_dialog.entry_x + password_dialog.entry_image.GetWidth() / 2 - row_width / 2;

    for (i = 0; password_dialog.bullet_sprite[i] || i < bullets; i++) {
        if (!password_dialog.bullet_sprite[i]) {
            password_dialog.bullet_sprite[i] = Sprite(password_dialog.bullet_image);
            password_dialog.bullet_sprite[i].SetZ(21);
        }
        if (i < bullets) {
            password_dialog.bullet_sprite[i].SetX(row_x + i * bullet_w);
            password_dialog.bullet_sprite[i].SetY(bullet_y);
            password_dialog.bullet_sprite[i].SetOpacity(1);
        } else {
            password_dialog.bullet_sprite[i].SetOpacity(0);
        }
    }
}

fun display_password_callback(prompt, bullets) {
    throbber.sprite.SetOpacity(0);

    if (!password_dialog.entry_sprite)
        password_dialog_setup(prompt);

    password_dialog.entry_sprite.SetOpacity(1);
    password_dialog.prompt_sprite.SetOpacity(1);
    password_dialog.lock_sprite.SetOpacity(1);
    if (password_dialog.name_sprite)
        password_dialog.name_sprite.SetOpacity(1);

    word_prompt_active = 1;
    if (word_mode == "1")
        word_draw(bullets);
    else
        plain_draw(bullets);

    redraw_boot_fresh();
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    throbber.sprite.SetOpacity(1);

    if (password_dialog.entry_sprite) {
        password_dialog.entry_sprite.SetOpacity(0);
        password_dialog.prompt_sprite.SetOpacity(0);
        password_dialog.lock_sprite.SetOpacity(0);
        if (password_dialog.name_sprite)
            password_dialog.name_sprite.SetOpacity(0);
        for (i = 0; password_dialog.bullet_sprite[i]; i++)
            password_dialog.bullet_sprite[i].SetOpacity(0);
        for (i = 0; password_dialog.pill_sprite[i]; i++)
            password_dialog.pill_sprite[i].SetOpacity(0);
        word_sync(0);
        word_prompt_active = 0;
        if (password_dialog.boot_fresh_sprite)
            password_dialog.boot_fresh_sprite.SetOpacity(0);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---------------------------------------------------------------------
# "Boot Fresh" -- skip resuming a pending hibernation image, offered only
# when one is actually pending. cyberbeest-askpass-boot-fresh (the
# crypttab keyscript wrapper) checks /boot/cyberbeest-hibernated -- the
# one filesystem readable before LUKS unlock -- and sends
# `plymouth update --status=cyberbeest-hibernated` before the password
# prompt is even shown, which is what update_status_callback below reacts
# to.
#
# Ctrl+F just toggles the visual state here. The actual "skip resume"
# effect happens entirely outside Plymouth: that same wrapper script
# strips the raw Ctrl+F byte (0x06) that Plymouth's own keyboard handling
# embeds directly into the typed password (ply-keyboard.c forwards every
# unmatched key to both the password buffer AND this script's keyboard
# callback -- there's no way to make it swallow the keystroke instead),
# and drops a marker for scripts/local-premount/resume to honor. This
# script never touches a file -- it can't; there's no file I/O in the
# .script language.
# ---------------------------------------------------------------------
hibernation_pending = false;
boot_fresh_selected = false;

fun redraw_boot_fresh() {
    if (!password_dialog.boot_fresh_sprite)
        return;

    if (!hibernation_pending) {
        password_dialog.boot_fresh_sprite.SetOpacity(0);
        return;
    }

    if (boot_fresh_selected) {
        boot_fresh_text = "Boot Fresh (Ctrl+F) -- selected";
        boot_fresh_dim = 1;
    } else {
        boot_fresh_text = "Boot Fresh (Ctrl+F)";
        boot_fresh_dim = 0.6;
    }
    password_dialog.boot_fresh_image = Image.Text(boot_fresh_text,
        text_red * boot_fresh_dim, text_green * boot_fresh_dim, text_blue * boot_fresh_dim,
        1, NULL, "center");
    password_dialog.boot_fresh_sprite.SetImage(password_dialog.boot_fresh_image);
    password_dialog.boot_fresh_sprite.SetX(screen.w / 2 - password_dialog.boot_fresh_image.GetWidth() / 2);
    password_dialog.boot_fresh_sprite.SetOpacity(1);
}

fun update_status_callback(status) {
    hibernation_pending = (status == "cyberbeest-hibernated");
    if (!hibernation_pending)
        boot_fresh_selected = false;
    redraw_boot_fresh();
}
Plymouth.SetUpdateStatusFunction(update_status_callback);

fun keyboard_input_callback(input) {
    word_note_key(input);
    if (!hibernation_pending)
        return;
    if (input == "") {
        boot_fresh_selected = !boot_fresh_selected;
        redraw_boot_fresh();
    }
}
Plymouth.SetKeyboardInputFunction(keyboard_input_callback);

fun quit_callback() {
}
Plymouth.SetQuitFunction(quit_callback);

# ---------------------------------------------------------------------
# Status/error messages (e.g. cryptsetup "bad password, try again"),
# sent via `plymouth message --text=...`. Without a handler these are
# silently dropped, which is why a failed unlock attempt looked like the
# screen just freezing.
# ---------------------------------------------------------------------
message.sprite = Sprite();
message.sprite.SetZ(30);
message.hide_countdown = 0;

# Substituted at install time (setup-grub-plymouth-theme.sh) from lib/i18n's
# plymouth.luks_success key. cryptsetup's own initramfs script sends
# "$CRYPTTAB_NAME: set up successfully" through this same message channel on
# a correct unlock -- rather than patching that upstream script (fragile
# across cryptsetup-initramfs package upgrades, and edits a file this repo
# doesn't own), just recognize its fixed suffix here and swap in our own
# text. CRYPTTAB_NAME varies per machine, so only the suffix is matched.
luks_success_text = "__LUKS_SUCCESS__";
luks_success_suffix = ": set up successfully";

fun ends_with(text, suffix) {
    text_len = text.Length();
    suffix_len = suffix.Length();
    if (text_len < suffix_len)
        return false;
    return text.SubString(text_len - suffix_len, text_len) == suffix;
}

fun message_callback(text) {
    # Reddish tint fits cryptsetup's error text (e.g. "bad password, try
    # again"), which is what this handler was originally built for -- but
    # is wrong for our own success text, so that gets the theme's normal
    # foreground color instead.
    is_success = ends_with(text, luks_success_suffix);
    if (is_success) {
        text = luks_success_text;
        msg_red = text_red; msg_green = text_green; msg_blue = text_blue;
    } else {
        msg_red = 1; msg_green = 0.35; msg_blue = 0.35;
    }
    message.image = Image.Text(text, msg_red, msg_green, msg_blue, 1);
    message.sprite.SetImage(message.image);
    message.x = screen.w / 2 - message.image.GetWidth() / 2;
    message.y = screen.h * 0.9;
    message.sprite.SetX(message.x);
    message.sprite.SetY(message.y);
    message.sprite.SetOpacity(1);
    message.hide_countdown = 150;  # ~5s, decremented in refresh_callback
}
Plymouth.SetMessageFunction(message_callback);
