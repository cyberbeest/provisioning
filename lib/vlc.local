# VLC opens files from anywhere and has to parse whatever a movie file
# contains, so a crafted file must not be able to write anything to disk.
# Read access is unrestricted (sensitive dot-folders stay hidden by the stock
# disable-*.inc blacklists); everything in the home folder is read-only
# except VLC's own settings/caches.
# The stock profile whitelists only a few folders, which hides every other
# one, so cancel those whitelists.
ignore include whitelist-common.inc
ignore include whitelist-player-common.inc
ignore whitelist ${HOME}/.cache/vlc
ignore whitelist ${HOME}/.config/vlc
ignore whitelist ${HOME}/.config/aacs
ignore whitelist ${HOME}/.dvdcss
ignore whitelist ${HOME}/.local/share/vlc
ignore whitelist ${DOWNLOADS}
ignore whitelist ${PICTURES}
read-only ${HOME}
read-write ${HOME}/.config/vlc
read-write ${HOME}/.cache/vlc
read-write ${HOME}/.local/share/vlc
# Files owned by another account's group (e.g. a mounted old home) need our
# supplementary groups; noroot's user namespace and nogroups both drop them.
ignore nogroups
ignore noroot
