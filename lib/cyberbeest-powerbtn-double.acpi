# Installed by ../55-powerbtn-double-press.sh -- see
# cyberbeest-powerbtn-double-press.sh. Same event pattern as
# acpi-support-base's stock powerbtn-acpi-support rule; where that package
# is installed too, both run (acpid runs every rule that matches).
event=button[ /]power
action=/usr/local/bin/cyberbeest-powerbtn-double-press.sh
